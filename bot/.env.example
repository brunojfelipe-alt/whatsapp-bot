# Evolution API
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-pela-AUTHENTICATION_API_KEY-do-docker/.env
EVOLUTION_INSTANCE=studio-fit

# URL que a Evolution API (rodando em container) usa para chamar o bot no host
WEBHOOK_URL=http://host.docker.internal:8000/webhook

# Número (com DDI+DDD, só dígitos) do atendente humano que recebe handoff
HANDOFF_NUMBER=5511999999999

# Arquivo de regras de negócio
BUSINESS_CONFIG=config/studio_fit.yaml

# LLM opcional (fallback fora do script)
OPENROUTER_API_KEY=

# Canal ativo: evolution (padrão) ou meta
CHANNEL=evolution

# Meta WhatsApp Cloud API (só necessário se CHANNEL=meta)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=escolha-um-token-qualquer
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
